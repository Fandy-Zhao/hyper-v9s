-    return {
-        "param_groups": len(optimizer_state.get("param_groups", [])),
-        "state_entries": len(state),
-    }
-
-
-__all__ = [
-    "CheckpointError",
-    "SCHEMA_VERSION",
-    "load_checkpoint",
-    "prune_resume_state",
-    "save_checkpoint",
-    "verify_config_compatibility",
-    "verify_resume_identity",
-]
