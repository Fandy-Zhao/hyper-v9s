-    return {
-        "status": "IDENTICAL",
-        "experts": len(pool.expert_records),
-        "keys": len(pool.key_records),
-        "alias_keys": len(actual_aliases),
-        "origin_key_by_expert": actual_origin,
-    }
-
-
-def verify_config_compatibility(
